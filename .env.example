# Copy to .env locally. Never commit actual values.
# Private LAN/VPN DNS name matching the verified SQL Server certificate.
# Current profile uses SQL authentication; keep actual credentials only in local .env or injected environment.
SQL_HOST=
SQL_PORT=1433
SQL_USER=
SQL_PASSWORD=
API_BASE_URL=https://api-employeedb.ccruces.com
API_INGEST_TOKEN=

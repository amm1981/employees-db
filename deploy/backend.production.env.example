APP_NAME=employees-db
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-employeedb.ccruces.com
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employees_db
DB_USERNAME=employees_api
